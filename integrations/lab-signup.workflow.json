      "parameters": { "mode": "runOnceForAllItems", "language": "javaScript", "jsCode": "const response = $input.first().json;\nconst email = $('normaliza').first().json.email;\nif (response.statusCode !== 200 || !Array.isArray(response.body)) throw new Error('wordpress_lookup_failed');\nconst user = response.body.find(user => typeof user.email === 'string' && user.email.trim().toLowerCase() === email);\nreturn [{json: {wp_id: Number.isInteger(user?.id) && user.id > 0 ? user.id : 0}}];" }
