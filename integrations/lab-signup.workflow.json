    {
      "name": "Resolver usuario criado", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [160, 120],
      "parameters": { "mode": "runOnceForAllItems", "language": "javaScript", "jsCode": "const response = $input.first().json;\nconst email = $('normaliza').first().json.email;\nif (response.statusCode !== 200 || !Array.isArray(response.body)) throw new Error('wordpress_confirmation_failed');\nconst user = response.body.find(user => typeof user.email === 'string' && user.email.trim().toLowerCase() === email);\nif (!Number.isInteger(user?.id) || user.id <= 0) throw new Error('wordpress_user_missing');\nreturn [{json: {wp_id: user.id}}];" }
    },
