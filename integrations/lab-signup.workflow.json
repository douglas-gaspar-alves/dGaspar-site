      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $input.first().json;\nconst nome = String(input.nome ?? '').trim().replace(/\\s+/g, ' ');\nconst email = String(input.email ?? '').trim().toLowerCase();\nlet whatsapp = String(input.whatsapp ?? '').replace(/\\D/g, '');\nif (whatsapp.length === 10 || whatsapp.length === 11) whatsapp = '55' + whatsapp;\nconst aceite = Array.isArray(input.aceite_termos) && input.aceite_termos.includes('Aceito os termos de uso do LAB');\nif (nome.length < 3 || nome.length > 200) throw new Error('Informe seu nome completo (3 a 200 caracteres).');\nif (email.length > 254 || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)) throw new Error('Informe um e-mail válido.');\nif (!/^55[1-9]\\d[2-9]\\d{7,8}$/.test(whatsapp) || /^(\\d)\\1+$/.test(whatsapp.slice(4))) throw new Error('Informe um WhatsApp válido com DDD.');\nif (!aceite) throw new Error('É preciso aceitar os termos de uso do LAB.');\nlet hash = 2166136261;\nfor (const char of email) hash = Math.imul(hash ^ char.charCodeAt(0), 16777619) >>> 0;\nconst user_login = 'lab_' + email.replace(/[^a-z0-9._-]/g, '_').slice(0, 40) + '_' + hash.toString(16);\nreturn [{json: {body: {nome, email, whatsapp, aceite_termos: true, user_login}}}];"
      }
