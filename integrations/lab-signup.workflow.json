          "buttonLabel": "Criar minha conta gratuita",
          "customCss": "/* Custom CSS for the n8n Form Trigger. This file is mirrored into options.customCss. */\n:root {\n  --font-family: Inter, system-ui, sans-serif;\n  --font-size-label: 13px;\n  --font-size-input: 14px;\n  --color-background: #0b0f26;\n  --color-card-bg: transparent;\n  --color-card-border: transparent;\n  --color-card-shadow: transparent;\n  --color-header: #f7faff;\n  --color-label: #cfe0f6;\n  --color-input-bg: #0b1027;\n  --color-input-border: #3a4869;\n  --color-input-text: #f7faff;\n  --color-link: #bac8df;\n  --color-focus-border: #00c2ff;\n  --color-submit-btn-bg: #00c2ff;\n  --color-submit-btn-text: #071221;\n  --color-required: #00c2ff;\n  --color-error: #ffb3bd;\n  --border-radius-card: 4px;\n  --border-radius-input: 4px;\n  --padding-container-top: 0px;\n  --padding-card: 0px;\n  --container-width: 100%;\n  --submit-btn-height: 52px;\n}\nbody { background: transparent; color: #f7faff; }\n.container { width: 100%; padding: 0; }\n.card { padding: 0; border: 0; box-shadow: none; background: transparent; }\n#n8n-form > .form-header { display: none; }\n.inputs-wrapper { padding: 0 0 15px; }\n.form-group { margin-bottom: 7px; }\nform .form-input { min-height: 47px; }\nform .form-input::placeholder { color: #bac8df; opacity: .7; }\nform :is(input, textarea, button):focus-visible, .multiselect-option input:focus-visible {\n  outline: 2px solid #00c2ff;\n  outline-offset: 2px;\n}\n.multiselect { padding-inline: 0; }\n.multiselect-option label { color: #bac8df; font-size: 13px; }\n#submit-btn { margin-top: 4px; }\n#submit-btn:hover { background: #79ddff; opacity: 1; }\n#submitted-form { padding: 15px 0; }\n#submitted-form .form-header :is(h1, p) { color: #f7faff; line-height: 1.5; }\n#submitted-form a { color: #00c2ff; }\n.n8n-link, hr { display: none; }\n@media (max-width: 500px) {\n  .container { width: 100%; min-height: 0; padding: 0; }\n  .card { padding: 0; margin: 0; border: 0; }\n}\n"
