---
import "../styles/service-page.css";
import { contactEmail } from "../lib/contact-links";

interface Props {
  tagline?: string;
	emailAddress?: string;
}

const {
	tagline = "Feito para glória de Deus",
	emailAddress = contactEmail,
} = Astro.props;
---

<footer class="service-footer">
			<div class="wrap">
				<a class="service-footer-brand" href="/"><img src="/images/logo-dgaspar.svg" alt="dGaspar" width="142" height="44" /></a>
				<p>{tagline}</p>
				<a href={`mailto:${emailAddress}`}>{emailAddress} ↗</a>
			</div>
		</footer>
