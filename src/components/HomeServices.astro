---

interface Props {
  eyebrow?: string;
  titleBefore?: string;
  titleAccent?: string;
  intro?: string;
  siteLabel?: string;
  personalLabel?: string;
  businessLabel?: string;
  siteHref?: string;
  personalHref?: string;
  businessHref?: string;
}

const {
  eyebrow = "Da ideia à implementação",
  titleBefore = "Quando for hora",
  titleAccent = "construir.",
  intro = "Também assumo projetos de execução com escopo definido em conjunto.",
  siteLabel = "Criação de sites",
  personalLabel = "Consultoria pessoal",
  businessLabel = "Consultoria empresarial",
  siteHref = "/servicos/criacao-de-sites/",
  personalHref = "/consultorias/agente-de-ia-pessoal/",
  businessHref = "/consultorias/",
} = Astro.props;
---

<section class="services-section" id="servicos" aria-labelledby="servicos-title"><div class="wrap services-inner"><div class="services-heading"><p class="eyebrow">{eyebrow}</p><h2 id="servicos-title">{titleBefore}<br />de <em>{titleAccent}</em></h2><p>{intro}</p></div><div class="service-list"><a class="service-item" href={siteHref}><span>01</span><p>{siteLabel}</p><b aria-hidden="true">↗</b></a><a class="service-item" href={personalHref}><span>02</span><p>{personalLabel}</p><b aria-hidden="true">↗</b></a><a class="service-item" href={businessHref}><span>03</span><p>{businessLabel}</p><b aria-hidden="true">↗</b></a></div></div></section>
