---
import "../styles/lab-page.css";
const onLabPage = Astro.url.pathname === "/lab/";
---

<header class="lab-header">
  <nav class="lab-wrap lab-nav" aria-label="Navegação do LAB">
    <a class="lab-home-link" href="/" aria-label="Voltar ao início do site dGaspar">
      <img src="/images/logo-lab-escuro.svg" alt="LAB dGaspar" width="138" height="64" />
    </a>
    <div class="lab-nav-links">
      <a href={onLabPage ? "#como-funciona" : "/lab/#como-funciona"}>Como funciona</a>
      <a href={onLabPage ? "#planos" : "/lab/#planos"}>Planos</a>
      <a href={onLabPage ? "#perguntas" : "/lab/#perguntas"}>Dúvidas</a>
    </div>
    <a class="lab-nav-action" href="https://lab.douglasgaspar.com/?fcom_action=auth">Entrar grátis <span aria-hidden="true">↗</span></a>
  </nav>
</header>
