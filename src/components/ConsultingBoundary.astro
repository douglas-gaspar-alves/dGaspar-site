---

interface Props {
  eyebrow?: string;
  titleBefore?: string;
  titleAccent?: string;
  body?: string;
  linkText?: string;
  servicesHref?: string;
}

const {
  eyebrow = "Escopo claro",
  titleBefore = "Você escolhe o que fazer depois da",
  titleAccent = "conversa.",
  body = "A consultoria é orientação sobre o seu caso. Ela não inclui criar integrações, instalar n8n ou colocar uma automação em produção. Você pode seguir por conta própria, com sua equipe ou pedir uma proposta separada se quiser delegar a execução.",
  linkText = "Conheça os serviços de execução",
  servicesHref = "/#servicos",
} = Astro.props;
---

<section class="consulting-page-section wrap" aria-labelledby="limites-title">
				<div class="consulting-page-boundary">
					<div><p class="eyebrow">{eyebrow}</p><h2 id="limites-title">{titleBefore} <em>{titleAccent}</em></h2></div>
					<div class="consulting-page-prose"><p>{body}</p><a class="text-link" href={servicesHref}>{linkText} <span aria-hidden="true">↗</span></a></div>
				</div>
			</section>
