---
import { contactEmail, whatsappLink } from "../lib/contact-links";

interface Props {
  eyebrow?: string;
  heading?: string;
  ctaLabel?: string;
  copyrightYear?: string;
  emailAddress?: string;
  whatsappHref?: string;
}

const {
  eyebrow = "A próxima boa ideia pode começar aqui.",
  heading = "Vamos conversar?",
  ctaLabel = "Falar no WhatsApp",
  copyrightYear = "2026",
  emailAddress = contactEmail,
  whatsappHref = whatsappLink,
} = Astro.props;
---

<footer class="site-footer" id="contato"><div class="wrap footer-top"><div><p class="eyebrow">{eyebrow}</p><h2>{heading}</h2></div><a class="footer-cta" href={whatsappHref} target="_blank" rel="noreferrer"><img class="footer-cta-mark" src="/images/icons/whatsapp.svg" alt="" width="30" height="30" decoding="async" />{ctaLabel} <span aria-hidden="true">↗</span></a></div><div class="wrap footer-bottom"><a class="brand" href="#inicio"><img src="/images/logo-dgaspar.svg" width="142" height="44" alt="dGaspar" /></a><p>Feito para glória de Deus</p><nav aria-label="Redes sociais"><a href="https://www.instagram.com/doug.gaspar/" target="_blank" rel="noreferrer">Instagram ↗</a><a href="https://www.youtube.com/@d-Gaspar" target="_blank" rel="noreferrer">YouTube ↗</a><a href={`mailto:${emailAddress}`}>{emailAddress}</a></nav><span class="copyright">© {copyrightYear} dGaspar</span></div></footer>
