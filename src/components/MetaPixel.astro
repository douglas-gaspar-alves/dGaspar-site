---
import { META_PIXEL_ID } from "../lib/analytics";

interface Props {
  /** ID numérico do Pixel. String vazia desliga a medição na página. */
  pixelId?: string;
}

const { pixelId = META_PIXEL_ID } = Astro.props;

// O ID vem de configuração, nunca de entrada do usuário. Ainda assim só
// dígitos entram no script e na URL de fallback.
const safeId = pixelId.trim().replace(/\D/g, "");

// Snippet base do Pixel: carrega fbevents.js e dispara PageView uma vez
// por documento. O site é multi-página, então cada navegação recarrega o HTML.
const pixelSnippet = `!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version="2.0";n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,"script","https://connect.facebook.net/en_US/fbevents.js");fbq("init","${safeId}");fbq("track","PageView");`;
---

{safeId && (
  <>
    <script is:inline set:html={pixelSnippet}></script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        alt=""
        src={`https://www.facebook.com/tr?id=${safeId}&ev=PageView&noscript=1`}
      />
    </noscript>
  </>
)}
