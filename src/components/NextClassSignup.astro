---
interface Props { href: string; label: string; compact?: boolean }
const { href, label, compact = false } = Astro.props;
---
<a class:list={["button", "next-signup", { "next-signup--compact": compact }]} href={href} target="_blank" rel="noopener noreferrer">
  {label}<span aria-hidden="true">↗</span><span class="sr-only"> (abre em nova aba)</span>
</a>
