---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  themeColor?: string;
  dataTheme?: string;
  bodyClass?: string;
  colorScheme?: string;
  preloadImage?: string;
  preloadDesktopImage?: string;
  preloadMobileImage?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageType?: string;
  ogImageWidth?: string;
  ogImageHeight?: string;
  twitterImage?: string;
  twitterImageAlt?: string;
  schemaKind?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  themeColor = "#101a33",
  dataTheme,
  bodyClass,
  colorScheme,
  preloadImage,
  preloadDesktopImage,
  preloadMobileImage,
  ogImage,
  ogImageAlt,
  ogImageType,
  ogImageWidth,
  ogImageHeight,
  twitterImage,
  twitterImageAlt,
  schemaKind,
  noindex = false,
} = Astro.props;

const siteUrl = "https://douglasgaspar.com/";
const personId = `${siteUrl}#person`;
const serviceName = schemaKind === "consultation"
  ? "Consultoria individual de IA e automação"
  : schemaKind === "agent-consultation"
    ? "Consultoria para criar seu agente de IA pessoal"
    : schemaKind === "site-creation"
      ? "Criação de sites sob proposta"
      : undefined;

// O mesmo identificador relaciona a pessoa, as páginas e os serviços sem
// inventar avaliações, preços, datas ou disponibilidade.
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${siteUrl}#website`, name: "dGaspar", url: siteUrl, inLanguage: "pt-BR" },
    {
      "@type": "Person",
      "@id": personId,
      name: "Douglas Gaspar",
      url: siteUrl,
      image: `${siteUrl}images/douglas-portrait.webp`,
      sameAs: ["https://www.instagram.com/doug.gaspar/", "https://www.youtube.com/@d-Gaspar"],
      ...(schemaKind === "person" ? {
        description,
        jobTitle: ["Criador de conteúdo", "Consultor de IA e automação", "Desenvolvedor"],
        knowsAbout: ["Inteligência artificial", "Automação", "n8n", "Vibe coding", "Criação de sites"],
      } : {}),
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: "pt-BR",
      isPartOf: { "@id": `${siteUrl}#website` },
      author: { "@id": personId },
      ...(serviceName ? { mainEntity: { "@id": `${canonical}#service` } } : {}),
    },
    ...(serviceName ? [{
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: serviceName,
      description,
      provider: { "@id": personId },
      areaServed: "BR",
      availableChannel: {
        "@type": "ServiceChannel",
        serviceUrl: canonical,
        availableLanguage: "pt-BR",
      },
    }] : []),
  ],
};
const schemaJson = JSON.stringify(schemaData).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="pt-BR" data-theme={dataTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    {colorScheme && <meta name="color-scheme" content={colorScheme} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} type="image/webp" fetchpriority="high" />}
    {preloadDesktopImage && <link rel="preload" as="image" href={preloadDesktopImage} type="image/webp" fetchpriority="high" media="(min-width: 641px)" />}
    {preloadMobileImage && <link rel="preload" as="image" href={preloadMobileImage} type="image/webp" fetchpriority="high" media="(max-width: 640px)" />}
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="dGaspar" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    {ogImageWidth && <meta property="og:image:width" content={ogImageWidth} />}
    {ogImageHeight && <meta property="og:image:height" content={ogImageHeight} />}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {twitterImage && <meta name="twitter:image" content={twitterImage} />}
    {twitterImageAlt && <meta name="twitter:image:alt" content={twitterImageAlt} />}
    <script type="application/ld+json" set:html={schemaJson} />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot name="header" />
    <main id="conteudo" tabindex="-1"><slot /></main>
    <slot name="footer" />
  </body>
</html>
