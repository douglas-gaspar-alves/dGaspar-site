  canonical="https://douglasgaspar.com/"
  dataTheme="light"
  colorScheme="light"
  preloadImage="/images/douglas-portrait.webp"
  ogImage="https://douglasgaspar.com/images/douglas-portrait.webp"
  ogImageType="image/webp"
  ogImageWidth="1084"
  ogImageHeight="1451"
  ogImageAlt="Retrato ilustrado de Douglas Gaspar"
  twitterImage="https://douglasgaspar.com/images/douglas-portrait.webp"
  twitterImageAlt="Retrato ilustrado de Douglas Gaspar"
  schemaKind="person"
>
  <HomeHero />
  <HomePaths />
  <HomeAbout />
  <HomeProjects />
  <HomeToolkit />
  <HomeConsulting />
  <HomeServices />
  <HomeFooter slot="footer" />
</SiteLayout>
