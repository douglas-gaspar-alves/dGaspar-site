---
import SiteLayout from "../../layouts/SiteLayout.astro";
import AgentHeader from "../../components/AgentHeader.astro";
import AgentHero from "../../components/AgentHero.astro";
import AgentFreeOffer from "../../components/AgentFreeOffer.astro";
import AgentRegistration from "../../components/AgentRegistration.astro";
import AgentUseCases from "../../components/AgentUseCases.astro";
import AgentGuided from "../../components/AgentGuided.astro";
import AgentScope from "../../components/AgentScope.astro";
import AgentExecution from "../../components/AgentExecution.astro";
import AgentFaq from "../../components/AgentFaq.astro";
import AgentClosingCTA from "../../components/AgentClosingCTA.astro";
import ConsultingFooter from "../../components/ConsultingFooter.astro";
---

<SiteLayout
  title="Consultoria para criar seu agente de IA pessoal | Douglas Gaspar"
  description="Primeira consultoria gratuita para criar seu agente de IA pessoal: diagnóstico do caso, demonstração com dados de exemplo e roteiro passo a passo."
  canonical="https://douglasgaspar.com/consultorias/agente-de-ia-pessoal/"
  dataTheme="light"
  colorScheme="light"
  bodyClass="agent-page"
  noindex
  ogImage="https://douglasgaspar.com/images/conversa.webp"
  ogImageAlt="Ilustração de Douglas Gaspar em uma conversa por vídeo"
  schemaKind="agent-consultation"
>
  <AgentHeader slot="header" />
  <AgentHero />
  <AgentFreeOffer />
  <AgentRegistration />
  <AgentUseCases />
  <AgentGuided />
  <AgentScope />
  <AgentExecution />
  <AgentFaq />
  <AgentClosingCTA />
  <ConsultingFooter slot="footer" tagline="Feito para glória de Deus" />
</SiteLayout>
